# Caminho do arquivo SQLite (a Parte 2 da prova pede SQLite)
DATABASE_URL=sqlite:///data/missions.db

# Chave usada para validar os tokens emitidos pelo serviço de autenticação
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
# Opcionais: se preenchidos, iss e aud passam a ser exigidos do token
# JWT_ISSUER=auth-service
# JWT_AUDIENCE=drone-missions-api

# Modelos de IA e origem das imagens processadas
MODELS_MANIFEST=models/manifest.json
IMAGES_ROOT=data/images

# Cache distribuído (vazio faz a API rodar sem Redis)
REDIS_URL=
IDEMPOTENCY_TTL_SECONDS=300

# Usadas apenas pelo docker-compose
API_PORT=8000
POSTGRES_USER=drone
POSTGRES_PASSWORD=drone
POSTGRES_DB=drone
